# Supabase connection (required)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional default country bias for OpenStreetMap Nominatim geocoding (leave blank for global queries)
VITE_GEOCODE_COUNTRY=India

# Set to 'true' once the `geocode-area` Supabase Edge Function is deployed
VITE_USE_GEOCODE_PROXY=false
